# ============================================================
# Google Gemini API Configuration
# Get your free key at: https://aistudio.google.com/app/apikey
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Port (default 5000)
PORT=5000

# ============================================================
# Supabase Database Configuration
# Get your project URL & API Keys at: https://supabase.com/dashboard/project/_/settings/api
# ============================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Optional: Service Role Key for elevated backend database access (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
